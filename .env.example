# ===========================================
# AI Food Packaging Recommendation System
# Environment Configuration
# ===========================================

# MySQL Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=food_packaging_db
MYSQL_USER=foodpack_user
MYSQL_PASSWORD=foodpack_pass
MYSQL_PORT=3306

# Spring Boot Backend
BACKEND_PORT=8080
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars
JWT_EXPIRATION=86400000

# Python ML Service
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# React Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api

# ===========================================
# IMPORTANT: Copy this file to .env
# Do NOT commit .env with real credentials
# ===========================================
